    <record id="x_reclamos_meli_tree" model="ir.ui.view">
        <field name="name">x_reclamos_meli.tree</field>
        <field name="model">x_reclamos_meli</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <tree class="o_autoazur_x_reclamos_meli"
                  string="Reclamos MeLi"
                  sample="1"
                  default_order="x_studio_date desc"
                  >
                <header>
                </header>
                <field name="x_name" optional="show"/>
                <field name="x_studio_observaciones_1" optional="show"/>
                <field name="x_studio_date" optional="show"/>
            </tree>
        </field>
    </record>




<record id="action_x_reclamos_meli" model="ir.actions.act_window">
        <field name="name">Reclamos MeLi</field>
        <field name="res_model">x_reclamos_meli</field>
