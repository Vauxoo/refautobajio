<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="view_x_reclamos_meli_form" model="ir.ui.view">
        <field name="name">x_reclamos_meli.form</field>
        <field name="model">x_reclamos_meli</field>
        <field name="arch" type="xml">
            <form string="Reclamos MeLi" class="o_x_reclamos_meli">
            <header>
            
            </header>
            <sheet>
                <div class="oe_title">
                    <h1>
                        <field name="x_name" readonly="1"/>
