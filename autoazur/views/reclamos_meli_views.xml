          <p class="o_view_nocontent_smiling_face">
            Reclamos MeLi
          </p><p>
            
          </p>
        </field>
    </record>

    <record id="action_x_reclamos_meli_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="autoazur.x_reclamos_meli_tree"/>
        <field name="act_window_id" ref="action_x_reclamos_meli"/>
    </record>
    <record id="action_x_reclamos_meli_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="autoazur.view_x_reclamos_meli_form"/>
        <field name="act_window_id" ref="action_x_reclamos_meli"/>
