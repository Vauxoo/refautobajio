<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--Customización Sale order Form-->
    <record id="sale_order_custom_view_form" model="ir.ui.view">
        <field name="name">sale.order.form_custom</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="type">form</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='customer_signature']" position="after">
                <page string="Autoazur" name="autoazur">
                        <group>
                            <group>
                            <field name="x_studio_tipo_de_venta"/>
                            <field name="x_studio_url_gua"/>
                            <field name="x_studio_mktcode"/>
                            <field name="x_studio_status"/>
                            <field name="x_studio_no_guia"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="team_id" string="Canal"/>
                            <field name="client_order_ref"/>
                        </group>
                        </group>
                    </page>

                <page string="Envío y Comisiones" name="envio_comisiones">
                        <field name="x_studio_lineenvcom" widget="section_and_note_one2many">
                            <tree editable="bottom">
                            <field optional="show" name="x_studio_producto"/>
                            <field optional="show" name="x_studio_cantidad"/>
                            <field optional="show" name="x_studio_precio_unitario"/>
                            <field optional="show" name="x_studio_subtotal" sum="Suma de Subtotal"/>
                            <field name="x_name" optional="hide"/>
                            <field optional="hide" name="x_studio_orden_de_venta"/>
                            <field name="x_studio_company_id" groups="base.group_multi_company" optional="hide"/>
                            </tree>
                        </field>
                    </page>
            </xpath>


            <xpath expr="//field[@name='partner_id']" position="after">
                            <field name="x_studio_volumen_total"/>
                            <field name="x_studio_conteo"/>
            </xpath>

            <xpath expr="//field[@name='payment_term_id']" position="after">
                            <field name="warehouse_id"/>
                            <field name="x_studio_fecha_mkt"/>

            </xpath>

            <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='order_lines']/field[@name='order_line']/tree[1]/field[@name='product_uom_qty']" position="after">
                <field optional="show" name="x_studio_volumen"/>
            </xpath>

            <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='order_lines']/field[@name='order_line']/tree[1]/field[@name='name']" position="after">
                <field optional="show" name="x_studio_orderid"/>
            </xpath>
        </field>
    </record>


    <record id="sale_order_custom_view_tree" model="ir.ui.view">
        <field name="name">sale.order.tree_custom</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree" />
        <field name="type">tree</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                            <field name="x_studio_reclamos_meli" optional="show"/>

            </xpath>
        </field>
    </record>

    <record id="sale_order_line_custom_view_tree" model="ir.ui.view">
        <field name="name">sale.order.line.tree_custom</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.view_order_line_tree" />
        <field name="type">tree</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom_qty']" position="after">
                            <field name="x_studio_volumen" optional="show"/>
                            <field name="x_studio_tipo_de_venta_lineas" optional="show"/>

            </xpath>
        </field>
    </record>
</odoo>