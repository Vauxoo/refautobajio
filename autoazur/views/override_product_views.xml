<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_custom_view_form" model="ir.ui.view">
        <field name="name">product.template.form_custom</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="type">form</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="x_studio_cdb"/>
                <field name="x_studio_cdb2"/>
            </xpath>



            <xpath expr="//form[@name='Product Template']/sheet[@name='product_form']/notebook[1]" position="inside">
                <page string="Sincronizar Autoazur" name="studio_page_1jg_1ivqg94pq">
                  <group name="studio_group_1jg">
                    <group name="studio_group_1jg_left">
                      <field name="x_studio_azaccountid"/>
                      <field name="x_studio_default_code"/>
                    </group>
                    <group name="studio_group_1jg_right">

                      <field name="x_studio_stock"/>
                      <field name="x_studio_double_validation"/>
                      <button string="Sincronizar"  name='productos_sincronizar_productos'  type="object" invisible="x_studio_double_validation != True or not x_studio_default_code"/>

                    </group>
                  </group>
                </page>

            </xpath>

        </field>
    </record>

    <record id="product_template_custom_view_form_variante" model="ir.ui.view">
        <field name="name">product.template.form_custom_variante</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="type">form</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="x_studio_cdb"/>
                <field name="x_studio_cdb2"/>
            </xpath>



            <xpath expr="//notebook" position="inside">
                <page string="Sincronizar Autoazur" name="studio_page_1jg_1ivqg94pq">
                  <group name="studio_group_1jg">
                    <group name="studio_group_1jg_left">
                      <field name="x_studio_azaccountid"/>
                      <field name="x_studio_default_code"/>
                    </group>
                    <group name="studio_group_1jg_right">

                      <field name="x_studio_stock"/>
                      <field name="x_studio_double_validation"/>
                    </group>
                  </group>
                </page>

            </xpath>

        </field>
    </record>


</odoo>