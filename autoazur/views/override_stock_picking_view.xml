<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_picking_custom_view_form" model="ir.ui.view">
        <field name="name">stock.picking.form_custom</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="type">form</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_infos']" position="inside">
                <field name="x_studio_orden_de_venta"/>
                <field name="x_studio_tipo_de_venta"/>
            </xpath>
        </field>
    </record>


</odoo>