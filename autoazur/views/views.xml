<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="view_x_logs_autoazur_form" model="ir.ui.view">
        <field name="name">x_logs_autoazur.form</field>
        <field name="model">x_logs_autoazur</field>
        <field name="arch" type="xml">
            <form string="Logs Autoazur" class="o_x_logs_autoazur" create='True'>
            <header>
            
            </header>
            <sheet>
                <div class="oe_title">
                    <h1>
                        <field name="x_name" readonly="1"/>
                    </h1>
                </div>
                <group name="x_logs_autoazur">
                    <group name="x_logs_autoazur_details">
                        <field name="x_studio_canal"/>
                    </group>
                    <group>
                        <field name="x_studio_actualizar" invisible="1"/>
                        <field name="x_studio_cdigo"/>
                        <field name="x_studio_codigo_log"/>
                        <field name="x_studio_status"/>
                    </group>
                    
                </group>
                <field name="x_studio_log"/>
            </sheet>
            
            </form>
        </field>
    </record>

    <record id="x_logs_autoazur_tree" model="ir.ui.view">
        <field name="name">x_logs_autoazur.tree</field>
        <field name="model">x_logs_autoazur</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <tree class="o_autoazur_x_logs_autoazur"
                  string="Logs Autoazur"
                  sample="1"
                  create="True"
                  default_order="create_date desc"
                  >
                <header>
                </header>
                <field name="x_studio_sequence" widget="handle"/>
                <field name="x_name" optional="show"/>
                <field name="x_studio_canal" optional="show"/>
                <field name="create_date" optional="show"/>
                
            </tree>
        </field>
    </record>

  <record id="action_x_logs_autoazur" model="ir.actions.act_window">
        <field name="name">Logs Autoazur</field>
        <field name="res_model">x_logs_autoazur</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Create and Consult Autoazur
          </p><p>
            
          </p>
        </field>
    </record>

    <record id="action_x_logs_autoazur_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="autoazur.x_logs_autoazur_tree"/>
        <field name="act_window_id" ref="action_x_logs_autoazur"/>
    </record>
    <record id="action_x_logs_autoazur_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="autoazur.view_x_logs_autoazur_form"/>
        <field name="act_window_id" ref="action_x_logs_autoazur"/>
    </record> 


    

    


    <menuitem name="Autoazur"
        id="menu_autoazur"
        sequence="20"
        web_icon="autoazur,static/description/autoazur.png"
        groups="base.group_user"/>

    <menuitem id="autoazur_menu_autoazur"
        name="Errores Sincronización Ventas"
        action="action_x_logs_autoazur"
        parent="menu_autoazur"
        sequence="30"/>



