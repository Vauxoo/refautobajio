<!--Vistas x_invubisync-->


<record id="view_x_invubisync_form" model="ir.ui.view">
        <field name="name">x_invubisync.form</field>
        <field name="model">x_invubisync</field>
        <field name="arch" type="xml">
            <form string="Invubisync" class="o_x_invubisync" create='True'>
            <header>
            
            </header>
            <sheet>
                <div class="oe_title">
                    <h1>
                        <field name="x_name" readonly="1"/>
                    </h1>
                </div>
                <group name="x_invubisync">
                    <group name="x_invubisync_details">
                        <!--<field name="x_studio_almacen"/>-->
                        <field name="x_studio_sincronizar_por"/>
                        <field name="x_studio_almacenes" widget="many2many_tags" invisible="x_studio_sincronizar_por != &quot;Almacen&quot;"/>
                        <field name="x_studio_ubicaciones" widget="many2many_tags" invisible="x_studio_sincronizar_por != &quot;Ubicacion&quot;"/>
                    </group>
                    <group>
                        <field name="x_studio_cantidad_minima"/>
                        <field name="x_studio_azaccountid"/>
                        <field name="x_studio_azwarehouseid"/>
                        
                    </group>
                    
                </group>
                <field name="x_studio_inventarios">
                    <tree>
                        <field name="x_name"/>
                        <field name="x_studio_producto" optional="show"/>
                        <field name="x_studio_sku" optional="show"/>
                        <field name="x_studio_cdb" optional="show"/>
                        <field name="x_studio_cdb2" optional="show"/>
                        <field name="x_studio_cdigo_de_barras" optional="show"/>
                        <field name="x_studio_stock" optional="show"/>
                        <field optional="show" name="x_studio_inventario_por_ubicacin"/>
                    </tree>
                </field>
            </sheet>
            
            </form>
        </field>
    </record>

